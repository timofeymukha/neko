{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neko:schema:simcomps:les_model",
  "$defs": {
    "simulationComponent": {
      "allOf": [
        {
          "$ref": "urn:neko:schema:simulation-components#/$defs/simcompBase"
        },
        {
          "$ref": "urn:neko:schema:simulation-components#/$defs/simcompFieldWriterOptions"
        },
        {
          "allOf": [
            {
              "$ref": "urn:neko:schema:simulation-components#/$defs/lesModelCommon"
            },
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "model": {
                      "const": "smagorinsky"
                    },
                    "c_s": {
                      "type": "number",
                      "x-neko-real": true
                    }
                  },
                  "additionalProperties": true
                },
                {
                  "type": "object",
                  "required": [
                    "test_filter"
                  ],
                  "properties": {
                    "model": {
                      "const": "dynamic_smagorinsky"
                    },
                    "test_filter": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/lesModelTestFilter"
                    }
                  },
                  "additionalProperties": true
                },
                {
                  "type": "object",
                  "properties": {
                    "model": {
                      "const": "vreman"
                    },
                    "c": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/numberOrRef"
                    },
                    "buoyancy_correction": {
                      "type": "boolean"
                    },
                    "scalar_field": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/nonEmptyString"
                    },
                    "Ri_c": {
                      "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
                    },
                    "reference_temperature": {
                      "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
                    },
                    "g": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/vector3OrRef"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "buoyancy_correction": {
                            "const": true
                          }
                        },
                        "required": [
                          "buoyancy_correction"
                        ]
                      },
                      "then": {
                        "required": [
                          "scalar_field",
                          "Ri_c",
                          "reference_temperature",
                          "g"
                        ]
                      }
                    }
                  ],
                  "additionalProperties": true
                },
                {
                  "type": "object",
                  "properties": {
                    "model": {
                      "const": "sigma"
                    },
                    "c": {
                      "type": "number",
                      "x-neko-real": true
                    }
                  },
                  "additionalProperties": true
                },
                {
                  "type": "object",
                  "properties": {
                    "model": {
                      "const": "wale"
                    },
                    "c_w": {
                      "type": "number",
                      "x-neko-real": true
                    }
                  },
                  "additionalProperties": true
                },
                {
                  "type": "object",
                  "required": [
                    "T0",
                    "g"
                  ],
                  "properties": {
                    "model": {
                      "const": "deardorff"
                    },
                    "c_k": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/numberOrRef"
                    },
                    "T0": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/numberOrRef"
                    },
                    "g": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/vector3OrRef"
                    },
                    "temperature_field": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/nonEmptyString"
                    },
                    "TKE_field": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/nonEmptyString"
                    },
                    "temperature_alphat_field": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/nonEmptyString"
                    },
                    "TKE_alphat_field": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/nonEmptyString"
                    },
                    "TKE_source_field": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/nonEmptyString"
                    },
                    "extrapolation": {
                      "const": false
                    }
                  },
                  "additionalProperties": true
                },
                {
                  "type": "object",
                  "required": [
                    "wall_distance_zone_indices"
                  ],
                  "properties": {
                    "model": {
                      "const": "spalart_allmaras"
                    },
                    "variant": {
                      "enum": [
                        "sa",
                        "sa-neg",
                        "sa-noft2",
                        "sa-noft2-neg"
                      ]
                    },
                    "scalar_field": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/nonEmptyString"
                    },
                    "source_field": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/nonEmptyString"
                    },
                    "alphat_field": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/nonEmptyString"
                    },
                    "wall_distance_zone_indices": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "integer"
                      }
                    },
                    "min_wall_distance": {
                      "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
                    },
                    "cb1": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/numberOrRef"
                    },
                    "cb2": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/numberOrRef"
                    },
                    "sigma": {
                      "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
                    },
                    "cw2": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/numberOrRef"
                    },
                    "cw3": {
                      "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
                    },
                    "cv1": {
                      "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
                    },
                    "ct3": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/numberOrRef"
                    },
                    "ct4": {
                      "$ref": "urn:neko:schema:simulation-components#/$defs/numberOrRef"
                    },
                    "kappa": {
                      "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
                    },
                    "cn1": {
                      "$ref": "urn:neko:schema:common#/$defs/positiveNumberOrRef"
                    }
                  },
                  "additionalProperties": true
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
