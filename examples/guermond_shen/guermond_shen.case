{
    "version": 1.0,
    "case": {
        "error_file": "error.csv",
        "mesh_file": "box.nmsh",
        "output_at_end": false,
        "output_boundary": false,
        "output_checkpoints": false,
        "time": {
            "end_time": 0.1,
            "timestep": 0.005
        },
        "numerics": {
            "time_order": 1,
            "polynomial_order": 5,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "advection": false,
            "mu": 1.0,
            "rho": 1.0,
            "initial_condition": {
                "type": "uniform",
                "value": [0.0, 0.0, 0.0]
            },
            "source_terms": [
                {
                    "type": "user"
                }
            ],
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-7,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-7,
                "max_iterations": 800
            },
            "output_control": "nsamples",
            "output_value": 1,
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [1, 2, 3, 4]
                }
            ]
        },
        "simulation_components": [
            {
                "type": "field_writer",
                "fields": ["error_u", "error_v", "error_p"],
                "output_control": "global"
            }
        ]
    }
}
